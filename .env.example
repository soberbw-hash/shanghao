PORT=43821
ROOM_NAME=ShangHao
MAX_ROOM_MEMBERS=5
MAX_CONNECTIONS=100

# Optional but strongly recommended for friends on different carriers/NATs.
# Run scripts/install-turn.sh on the server, then keep these values private.
# TURN_URLS=turn:your.public.ip:3478?transport=udp,turn:your.public.ip:3478?transport=tcp
# TURN_SHARED_SECRET=replace-with-a-long-random-secret
# TURN_CREDENTIAL_TTL_SECONDS=86400

# Persist the latest 100 normal chat messages across relay restarts.
CHAT_HISTORY_FILE=./data/chat-history.json

# Require clients to present this token when joining a public relay.
# Generate a long random value and keep it private.
# RELAY_ACCESS_TOKEN=replace-with-a-long-random-token

# Account system. Keep SUPABASE_SECRET_KEY on the relay server only.
# Apply supabase/migrations/202608240001_accounts_v1.sql before enabling accounts.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# SUPABASE_SECRET_KEY=sb_secret_replace_me
# SUPABASE_PASSWORD_RESET_REDIRECT_URL=https://voice.example.com/account/reset
# Production should require accounts; local development may explicitly allow guests.
# SHANGHAO_ALLOW_GUESTS=false

# Temporary account testing over the existing ws/http relay. Both values are required.
# Passwords and refresh tokens still go directly to Supabase HTTPS; only short-lived access
# tokens are accepted by the relay for profile and room identity verification.
# SHANGHAO_DEPLOYMENT_MODE=development
# ALLOW_INSECURE_DEV_CONNECTION=true
